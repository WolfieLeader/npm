{
  "name": "npm-packages",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "lint": "turbo run lint && oxlint --type-aware scripts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "smoke": "bash scripts/run.sh",
    "workers": "node scripts/workers.ts",
    "knip": "knip",
    "verify": "node scripts/verify.ts",
    "tool-pins": "bash scripts/tool-pins.sh"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "knip": "catalog:",
    "miniflare": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  }
}

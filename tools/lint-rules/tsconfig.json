{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    // Oxlint imports `src/index.ts` directly and Node strips the types, so imports name the `.ts` file.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}

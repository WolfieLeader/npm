{
  "name": "generate-certs",
  "version": "4.1.0",
  "description": "🗝️ Effortless HTTPS Certificate Generation for Local Development",
  "homepage": "https://github.com/WolfieLeader/npm/tree/main/packages/generate-certs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfieLeader/npm.git",
    "directory": "packages/generate-certs"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json .",
    "prepublishOnly": "turbo run build --filter=generate-certs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "catalog:",
    "@types/node-forge": "catalog:",
    "node-forge": "^1.4.2",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "WolfieLeader",
  "license": "MIT",
  "keywords": [
    "https",
    "ssl",
    "certificates",
    "development",
    "generate",
    "security",
    "server",
    "backend",
    "local"
  ]
}

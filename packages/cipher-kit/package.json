{
  "name": "cipher-kit",
  "version": "4.1.0",
  "description": "🔐 Secure, Modern, and Cross-Platform Cryptography Helpers for Web, Node.js, Deno, Bun, and Cloudflare Workers",
  "homepage": "https://github.com/WolfieLeader/npm/tree/main/packages/cipher-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfieLeader/npm.git",
    "directory": "packages/cipher-kit"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./web-api": {
      "import": {
        "types": "./dist/web-api.d.ts",
        "default": "./dist/web-api.js"
      },
      "require": {
        "types": "./dist/web-api.d.cts",
        "default": "./dist/web-api.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json .",
    "prepublishOnly": "turbo run build --filter=cipher-kit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@internal/helpers": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "WolfieLeader",
  "license": "MIT",
  "keywords": [
    "encrypt",
    "crypto",
    "cipher",
    "security",
    "hash",
    "password",
    "uuid",
    "web",
    "node",
    "deno",
    "bun",
    "cloudflare"
  ]
}

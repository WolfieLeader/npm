{
  "name": "compress-kit",
  "version": "4.1.0",
  "description": "🔬 Reliable, Cross-Platform Compression & Decompression for Web, Node.js, Deno, Bun and Cloudflare Workers",
  "homepage": "https://github.com/WolfieLeader/npm/tree/main/packages/compress-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfieLeader/npm.git",
    "directory": "packages/compress-kit"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json .",
    "prepublishOnly": "turbo run build --filter=compress-kit"
  },
  "dependencies": {
    "pako": "^3.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@internal/helpers": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "WolfieLeader",
  "license": "MIT",
  "keywords": [
    "compress",
    "compression",
    "web",
    "node",
    "deno",
    "bun",
    "cloudflare"
  ]
}

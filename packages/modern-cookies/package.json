{
  "name": "modern-cookies",
  "version": "3.0.0",
  "description": "🍪 A Lightweight and Modern Cookie Utility for Express and Nest.js",
  "homepage": "https://github.com/WolfieLeader/npm/tree/main/packages/modern-cookies#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfieLeader/npm.git",
    "directory": "packages/modern-cookies"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json .",
    "prepublishOnly": "turbo run build --filter=modern-cookies"
  },
  "dependencies": {
    "cookie": "^2.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "WolfieLeader",
  "license": "MIT",
  "keywords": [
    "express",
    "nestjs",
    "server",
    "backend",
    "cookies",
    "http",
    "cookie-parser"
  ]
}

{
  "name": "get-client-ip",
  "version": "5.1.0",
  "description": "📍 A Lightweight Utility for Extracting the Real Client IP Address from Incoming HTTP Requests",
  "homepage": "https://github.com/WolfieLeader/npm/tree/main/packages/get-client-ip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfieLeader/npm.git",
    "directory": "packages/get-client-ip"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json .",
    "prepublishOnly": "turbo run build --filter=get-client-ip"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "WolfieLeader",
  "license": "MIT",
  "keywords": [
    "ip",
    "express",
    "nestjs",
    "server",
    "backend",
    "middleware",
    "http"
  ]
}
